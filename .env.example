# ---- Backend (copy to backend/.env and fill in) ----
DATABASE_URL=sqlite:///./cit_scheduler.db
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173

# ---- LLM (optional: if empty, the built-in rules parser is used and manual forms still work) ----
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ---- Frontend (set in the frontend host, e.g. Vercel) ----
VITE_API_URL=http://127.0.0.1:8000
